      "link": null,
      "locked": false,
      "text": "14 curl sends the question and a signed token\n15 verify the signature with JWT_SECRET;\n    nothing is looked up anywhere\n16 embed the question with Titan\n17 search Qdrant with a filter built from the\n    token's claims, inside the search\n18 send only the permitted chunks to Claude\n19 the apac profile serves it inside APAC",
      "fontSize": 14,
      "fontFamily": 4,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "14 curl sends the question and a signed token\n15 verify the signature with JWT_SECRET;\n    nothing is looked up anywhere\n16 embed the question with Titan\n17 search Qdrant with a filter built from the\n    token's claims, inside the search\n18 send only the permitted chunks to Claude\n19 the apac profile serves it inside APAC",
      "lineHeight": 1.25
    }
