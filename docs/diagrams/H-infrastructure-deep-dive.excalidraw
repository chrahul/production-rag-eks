      "roundness": null,
      "seed": 292209685,
      "version": 1,
      "versionNonce": 290637371,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1754500000000,
      "link": null,
      "locked": false,
      "text": "1  terraform apply creates all 63 AWS resources\n2  aws s3 cp puts the corpus and manifest in S3\n3  docker push puts image v2 in ECR\n4  kubectl talks to the EKS API over HTTPS;\n    your IAM user is cluster admin",
      "fontSize": 14,
      "fontFamily": 4,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1  terraform apply creates all 63 AWS resources\n2  aws s3 cp puts the corpus and manifest in S3\n3  docker push puts image v2 in ECR\n4  kubectl talks to the EKS API over HTTPS;\n    your IAM user is cluster admin",
      "lineHeight": 1.25
    },
    {
      "id": "h7946411234",
      "type": "text",
      "x": 600,
      "y": 1710,
      "width": 196,
