      "boundElements": null,
      "updated": 1754500000000,
      "link": null,
      "locked": false,
      "text": "11 read manifest.yaml, then each listed document\n    (unlisted documents are skipped, fail closed)\n12 embed each chunk with Titan in ap-south-1\n13 write 17 points to Qdrant, each carrying what\n    the document IS, never who may read it",
      "fontSize": 14,
      "fontFamily": 4,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "11 read manifest.yaml, then each listed document\n    (unlisted documents are skipped, fail closed)\n12 embed each chunk with Titan in ap-south-1\n13 write 17 points to Qdrant, each carrying what\n    the document IS, never who may read it",
      "lineHeight": 1.25
    },
