      "updated": 1754500000000,
      "link": null,
      "locked": false,
      "text": "kubectl         applies k8s/, port-forwards to the API  (4)\nmint_tokens.py  signs JWTs, stands in for Entra or Okta\ncurl            asks the question as Sam, Arjun, Priya  (14)",
      "fontSize": 15,
      "fontFamily": 4,
      "textAlign": "left",
      "verticalAlign": "top",
